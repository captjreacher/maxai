# Public intake endpoint used by the browser contact form. Must be the
# canonical mgrnz-public-intake Supabase Edge Function (public,
# verify_jwt=false) so submissions land in Cockpit contacts/cases/events.
PUBLIC_MAXAI_INTAKE_ENDPOINT=https://jqfodlzcsgfocyuawzyx.supabase.co/functions/v1/mgrnz-public-intake

# Build/server-only Billing catalogue access. The base URL includes the
# configured admin API base path (normally /api/v1). The API key must be a
# runtime.viewer bearer token with catalogue.read permission. The HMAC signing
# key never belongs in this site. Never prefix either value with PUBLIC_; they
# are consumed only by src/server/billing-catalogue.js.
MAXAI_BILLING_CATALOGUE_API_BASE_URL=
MAXAI_BILLING_CATALOGUE_BEARER_TOKEN=