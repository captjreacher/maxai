---
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { loadPageData } from '../data/pages';
import solutionsImage from '../images/solutions-solutions.jpg';

const page = await loadPageData('solutions');
---

<BaseLayout
  title={page.title}
  description={page.description}
>
  <section class="solutions-hero">
    <div class="solutions-hero__inner container">
      <div class="solutions-hero__content">
        <p class="eyebrow">{page.hero.eyebrow}</p>
        <h1>{page.hero.heading}</h1>
        <p class="solutions-hero__copy">
          {page.hero.description}
        </p>
        <div class="solutions-hero__actions" aria-label="Solutions page actions">
          <Button href={page.hero.primaryCta.href}>{page.hero.primaryCta.label}</Button>
          <Button href={page.hero.secondaryCta.href} variant="secondary">{page.hero.secondaryCta.label}</Button>
        </div>
      </div>

      <div class="solutions-hero__signal surface">
        <Image src={solutionsImage} alt={page.hero.imageAlt} />
      </div>
    </div>
  </section>

  <section class="section-band" aria-labelledby={page.problem.id}>
    <div class="container problem-layout">
      <SectionHeading
        id={page.problem.id}
        eyebrow={page.problem.eyebrow}
        title={page.problem.heading}
      />

      <div class="problem-copy">
        {page.problem.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section-band section-band--dark" aria-labelledby={page.capabilities.id}>
    <div class="container">
      <SectionHeading
        id={page.capabilities.id}
        eyebrow={page.capabilities.eyebrow}
        title={page.capabilities.heading}
        intro={page.capabilities.description}
      />

      <div class="solutions-grid">
        {
          page.capabilities.solutions.map((solution) => (
            <article class="solution-card surface" id={solution.anchorId}>
              <div class="solution-card__header">
                <span class="solution-card__bar" aria-hidden="true"></span>
                <h3>{solution.title}</h3>
                <p>{solution.lead}</p>
              </div>

              <div class="solution-card__capabilities">
                <h4>{page.capabilities.capabilityLabel}</h4>
                <ul>
                  {solution.capabilities.map((capability) => <li>{capability}</li>)}
                </ul>
              </div>

              <p class="solution-card__outcome">
                <strong>{page.capabilities.outcomeLabel}</strong> {solution.outcome}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-band architecture-band" aria-labelledby={page.architecture.id}>
    <div class="container">
      <div class="architecture-layout">
        <SectionHeading
          id={page.architecture.id}
          eyebrow={page.architecture.eyebrow}
          title={page.architecture.heading}
          intro={page.architecture.description}
        />

        <ol class="architecture-flow" aria-label={page.architecture.ariaLabel}>
          {
            page.architecture.layers.map((layer, index) => (
              <li>
                <span class="architecture-flow__number">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>{layer}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section-band section-band--dark" aria-labelledby={page.caseExample.id}>
    <div class="container">
      <article class="case-feature surface solutions-case">
        <div class="case-feature__media solutions-case__media" aria-hidden="true"></div>
        <div class="case-feature__body">
          <span class="case-feature__label">{page.caseExample.label}</span>
          <h2 id={page.caseExample.id}>{page.caseExample.heading}</h2>
          <p>{page.caseExample.description}</p>
          <dl>
            {page.caseExample.details.map((detail) => (
              <div>
                <dt>{detail.term}</dt>
                <dd>{detail.description}</dd>
              </div>
            ))}
          </dl>
          <div class="section-link">
            <Button href={page.caseExample.cta.href} variant="text">{page.caseExample.cta.label}</Button>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="cta-band" aria-labelledby={page.cta.id}>
    <div class="container">
      <div class="cta-panel surface">
        <div>
          <p class="eyebrow">{page.cta.eyebrow}</p>
          <h2 id={page.cta.id}>{page.cta.heading}</h2>
          <p>{page.cta.description}</p>
        </div>
        <Button href={page.cta.button.href}>{page.cta.button.label}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .solutions-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 11vw, 8.5rem) clamp(4rem, 9vw, 6.5rem);
  }

  .solutions-hero::before {
    position: absolute;
    right: 6vw;
    top: 3rem;
    z-index: -1;
    width: min(46vw, 34rem);
    height: min(46vw, 34rem);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 79, 0, 0.22), transparent 62%);
    filter: blur(26px);
    content: "";
  }

  .solutions-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 27rem);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }

  .solutions-hero__content {
    max-width: 58rem;
  }

  .solutions-hero h1 {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: 0;
  }

  .solutions-hero__copy {
    max-width: 43rem;
    margin: var(--space-lg) 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .solutions-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  .solutions-hero__signal {
    position: relative;
    min-height: 28rem;
    overflow: hidden;
    background: var(--color-panel-hot);
  }

  .solutions-hero__signal::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(5, 5, 5, 0.28), transparent 58%);
    pointer-events: none;
    content: "";
  }

  .solutions-hero__signal img {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    object-position: center;
  }

  .problem-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
  }

  .problem-copy {
    border-left: 1px solid var(--color-border-strong);
    padding-left: clamp(1rem, 3vw, 2rem);
  }

  .problem-copy p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(1.04rem, 1.7vw, 1.18rem);
  }

  .problem-copy p + p {
    margin-top: var(--space-lg);
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  .solution-card {
    display: grid;
    grid-column: span 3;
    grid-template-rows: auto 1fr auto;
    min-height: 29rem;
    overflow: hidden;
    padding: var(--space-lg);
  }

  .solution-card:nth-child(5) {
    grid-column: 2 / span 4;
  }

  .solution-card__bar {
    display: block;
    width: 2.4rem;
    height: 0.18rem;
    margin-bottom: var(--space-lg);
    border-radius: 999px;
    background: var(--color-brand);
    box-shadow: 0 0 18px rgba(255, 79, 0, 0.36);
  }

  .solution-card h3 {
    margin: 0;
    max-width: 13ch;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .solution-card__header p {
    margin: var(--space-md) 0 0;
    max-width: 39rem;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .solution-card__capabilities {
    margin-top: var(--space-xl);
  }

  .solution-card h4 {
    margin: 0 0 var(--space-sm);
    color: var(--color-brand-amber);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .solution-card ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .solution-card li {
    position: relative;
    min-width: 0;
    padding-left: 1rem;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .solution-card li::before {
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: var(--color-brand);
    box-shadow: 0 0 12px rgba(255, 79, 0, 0.42);
    content: "";
  }

  .solution-card__outcome {
    margin: var(--space-xl) 0 0;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
    color: var(--color-text-muted);
  }

  .solution-card__outcome strong {
    color: var(--color-text);
  }

  .architecture-band {
    overflow: hidden;
  }

  .architecture-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.74fr) minmax(0, 1.26fr);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }

  .architecture-flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: clamp(1rem, 3vw, 2rem) 0;
    list-style: none;
  }

  .architecture-flow::before {
    position: absolute;
    left: 2rem;
    right: 2rem;
    top: 50%;
    height: 2px;
    background: linear-gradient(
      90deg,
      rgba(255, 79, 0, 0.18),
      rgba(255, 179, 71, 0.66),
      rgba(255, 79, 0, 0.18)
    );
    box-shadow: 0 0 22px rgba(255, 79, 0, 0.22);
    content: "";
  }

  .architecture-flow li {
    position: relative;
    display: grid;
    min-height: 11.5rem;
    align-content: space-between;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    background:
      radial-gradient(circle at 50% 50%, rgba(255, 79, 0, 0.13), transparent 48%),
      var(--color-panel);
    box-shadow: var(--shadow-panel);
    color: var(--color-text);
    font-weight: 900;
    line-height: 1.1;
  }

  .architecture-flow li:not(:first-child)::before {
    position: absolute;
    left: calc(var(--space-md) * -1);
    top: 50%;
    z-index: 2;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgba(255, 176, 0, 0.42);
    border-radius: 999px;
    background: var(--color-bg);
    box-shadow: 0 0 22px rgba(255, 79, 0, 0.34);
    color: var(--color-brand-amber);
    content: "←";
    font-weight: 900;
    transform: translate(-50%, -50%);
  }

  .architecture-flow__number {
    color: var(--color-brand);
    font-size: 0.78rem;
  }

  .solutions-case h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .solutions-case__media {
    background:
      radial-gradient(circle at 32% 28%, rgba(255, 179, 71, 0.24), transparent 0.24rem),
      radial-gradient(circle at 62% 48%, rgba(255, 79, 0, 0.26), transparent 0.32rem),
      linear-gradient(135deg, rgba(255, 79, 0, 0.22), transparent 58%),
      linear-gradient(180deg, rgba(255, 247, 237, 0.05), transparent),
      var(--color-bg-soft);
  }

  .solutions-case .case-feature__body > p {
    max-width: 40rem;
  }

  @media (max-width: 960px) {
    .solutions-hero__inner,
    .problem-layout,
    .architecture-layout {
      grid-template-columns: 1fr;
    }

    .solutions-grid {
      grid-template-columns: 1fr;
    }

    .solution-card,
    .solution-card:nth-child(5) {
      grid-column: auto;
    }

    .architecture-flow {
      grid-template-columns: 1fr;
    }

    .architecture-flow::before {
      inset: 2rem auto 2rem 2rem;
      width: 2px;
      height: auto;
      background: linear-gradient(
        180deg,
        rgba(255, 79, 0, 0.18),
        rgba(255, 179, 71, 0.66),
        rgba(255, 79, 0, 0.18)
      );
    }

    .architecture-flow li {
      min-height: 8rem;
      padding-left: 4rem;
    }

    .architecture-flow li:not(:first-child)::before {
      left: 2rem;
      top: calc(var(--space-md) * -1);
      content: "↑";
      transform: translate(-50%, -50%);
    }
  }

  @media (max-width: 820px) {
    .solutions-hero__signal {
      min-height: 17rem;
    }
  }

  @media (max-width: 560px) {
    .solutions-hero {
      padding-block-start: 3.5rem;
    }

    .solutions-hero h1 {
      font-size: clamp(2.8rem, 15vw, 4.5rem);
    }

    .solution-card {
      min-height: auto;
    }

    .solution-card ul {
      grid-template-columns: 1fr;
    }
  }
</style>
