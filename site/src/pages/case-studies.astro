---
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPageData } from '../data/pages';

const page = await loadPageData('case-studies');
---

<BaseLayout
  title={page.title}
  description={page.description}
>
  <section class="cases-hero section-band--fire-glow">
    <div class="cases-hero__inner container">
      <div class="cases-hero__content">
        <p class="eyebrow">{page.hero.eyebrow}</p>
        <h1>{page.hero.heading}</h1>
        <p class="cases-hero__copy">
          {page.hero.description}
        </p>
      </div>

      <div class="cases-hero__signal surface" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </section>

  <section class="section-band section-band--embers" aria-labelledby={page.featuredCase.id}>
    <div class="container">
      <article class="featured-case surface">
        <header class="featured-case__header">
          <div>
            <p class="eyebrow">{page.featuredCase.eyebrow}</p>
            <h2 id={page.featuredCase.id}>{page.featuredCase.title}</h2>
          </div>
          <span class="featured-case__marker">{page.featuredCase.marker}</span>
        </header>

        <div class="featured-case__content">
          <section aria-labelledby={page.featuredCase.problem.id}>
            <p class="case-label" id={page.featuredCase.problem.id}>{page.featuredCase.problem.label}</p>
            <p class="featured-case__lead">
              {page.featuredCase.problem.description}
            </p>
          </section>

          <section aria-labelledby={page.featuredCase.work.id}>
            <p class="case-label" id={page.featuredCase.work.id}>{page.featuredCase.work.label}</p>
            <ul class="delivery-list">
              {page.featuredCase.work.delivered.map((item) => <li>{item}</li>)}
            </ul>
          </section>

          <section class="featured-case__capability" aria-labelledby={page.featuredCase.capability.id}>
            <p class="case-label" id={page.featuredCase.capability.id}>{page.featuredCase.capability.label}</p>
            <p>
              {page.featuredCase.capability.description}
            </p>
          </section>

          <section class="featured-case__testimonial" aria-labelledby={page.featuredCase.testimonial.id}>
            <div>
              <p class="case-label" id={page.featuredCase.testimonial.id}>{page.featuredCase.testimonial.eyebrow}</p>
              <blockquote>
                <p>{page.featuredCase.testimonial.quote}</p>
                <footer>{page.featuredCase.testimonial.attribution}</footer>
              </blockquote>
            </div>
            <div class="featured-case__actions" aria-label="Super City Interiors evidence links">
              <Button href={page.featuredCase.testimonial.internalCta.href} variant="secondary">
                {page.featuredCase.testimonial.internalCta.label}
              </Button>
              <a
                class="featured-case__external"
                href={page.featuredCase.clientLink.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{page.featuredCase.clientLink.label}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>
        </div>
      </article>
    </div>
  </section>

  <section class="section-band section-band--horizon evidence-band" aria-labelledby={page.evidence.id}>
    <div class="container evidence-layout">
      <SectionHeading
        id={page.evidence.id}
        eyebrow={page.evidence.eyebrow}
        title={page.evidence.heading}
        intro={page.evidence.description}
      />

      <ul class="evidence-list">
        {page.evidence.criteria.map((criterion, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {criterion}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-band section-band--quiet" aria-labelledby={page.futureCases.id}>
    <div class="container">
      <SectionHeading
        id={page.futureCases.id}
        eyebrow={page.futureCases.eyebrow}
        title={page.futureCases.heading}
        intro={page.futureCases.description}
      />

      <div class="future-case-grid">
        {page.futureCases.items.map((description) => (
          <article class="future-case surface">
            <span class="future-case__status">{page.futureCases.status}</span>
            <h3>{page.futureCases.cardHeading}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band" aria-labelledby={page.cta.id}>
    <div class="container">
      <div class="cta-panel surface">
        <div>
          <p class="eyebrow">{page.cta.eyebrow}</p>
          <h2 id={page.cta.id}>{page.cta.heading}</h2>
          <p>{page.cta.description}</p>
        </div>
        <Button href={page.cta.button.href}>{page.cta.button.label}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cases-hero { position: relative; overflow: hidden; padding-block: clamp(5rem, 11vw, 8.5rem) clamp(4rem, 9vw, 6.5rem); }
  .cases-hero::before { position: absolute; right: 8vw; top: 3rem; z-index: -1; width: min(44vw, 34rem); height: min(44vw, 34rem); border-radius: 50%; background: radial-gradient(circle, rgba(255, 79, 0, 0.2), transparent 64%); filter: blur(26px); content: ""; }
  .cases-hero__inner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 27rem); gap: clamp(2rem, 7vw, 5rem); align-items: center; }
  .cases-hero__content { max-width: 58rem; }
  .cases-hero h1 { margin: 0; max-width: 12ch; font-family: var(--font-display); font-size: clamp(3rem, 9vw, 6.9rem); font-weight: 900; line-height: 0.92; letter-spacing: 0; }
  .cases-hero__copy { max-width: 44rem; margin: var(--space-lg) 0 0; color: var(--color-text-muted); font-size: clamp(1.05rem, 2vw, 1.25rem); }
  .cases-hero__signal { position: relative; min-height: 27rem; overflow: hidden; background: linear-gradient(180deg, rgba(255, 247, 237, 0.06), transparent 34%), linear-gradient(135deg, var(--color-panel-hot), var(--color-bg) 72%); }
  .cases-hero__signal::before { position: absolute; inset: 14% 18%; border: 1px solid var(--color-border-strong); border-radius: var(--radius-lg); background: linear-gradient(180deg, rgba(255, 79, 0, 0.14), transparent 36%), var(--color-panel); box-shadow: var(--shadow-ember); content: ""; }
  .cases-hero__signal::after { position: absolute; left: 28%; right: 28%; top: 34%; height: 1px; background: var(--color-border-strong); box-shadow: 0 3rem 0 var(--color-border), 0 6rem 0 var(--color-border); content: ""; }
  .cases-hero__signal span { position: absolute; left: 23%; z-index: 1; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-brand); box-shadow: 0 0 16px rgba(255, 79, 0, 0.68); }
  .cases-hero__signal span:nth-child(1) { top: 33%; }
  .cases-hero__signal span:nth-child(2) { top: calc(33% + 3rem); }
  .cases-hero__signal span:nth-child(3) { top: calc(33% + 6rem); }
  .featured-case { overflow: hidden; }
  .featured-case__header { display: flex; align-items: start; justify-content: space-between; gap: var(--space-lg); border-bottom: 1px solid var(--color-border); padding: clamp(1.5rem, 4vw, 3rem); background: radial-gradient(circle at 85% 20%, rgba(255, 79, 0, 0.18), transparent 24rem), linear-gradient(135deg, rgba(255, 79, 0, 0.08), transparent 48%); }
  .featured-case__header h2 { margin: 0; font-size: clamp(2.4rem, 7vw, 5.5rem); line-height: 0.94; letter-spacing: 0; }
  .featured-case__marker { color: var(--color-brand); font-size: clamp(1.5rem, 4vw, 3rem); font-weight: 900; }
  .featured-case__content { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .featured-case__content > section { padding: clamp(1.5rem, 4vw, 3rem); }
  .featured-case__content > section:nth-child(2) { border-left: 1px solid var(--color-border); }
  .featured-case__capability { grid-column: 1 / -1; border-top: 1px solid var(--color-border); background: rgba(255, 79, 0, 0.05); }
  .featured-case__testimonial { display: grid; grid-column: 1 / -1; grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr); gap: clamp(1.5rem, 5vw, 3.5rem); align-items: end; border-top: 1px solid var(--color-border); padding: clamp(1.5rem, 4vw, 3rem); background: radial-gradient(circle at 88% 18%, rgba(255, 79, 0, 0.22), transparent 20rem), linear-gradient(135deg, rgba(255, 79, 0, 0.14), transparent 54%), var(--color-panel); }
  .featured-case__testimonial blockquote { margin: var(--space-lg) 0 0; }
  .featured-case__testimonial blockquote p { margin: 0; max-width: 52rem; color: var(--color-text); font-size: clamp(1.35rem, 3vw, 2.3rem); font-weight: 900; line-height: 1.16; }
  .featured-case__testimonial blockquote p::before { color: var(--color-brand); content: "“"; }
  .featured-case__testimonial blockquote p::after { color: var(--color-brand); content: "”"; }
  .featured-case__testimonial blockquote footer { margin-top: var(--space-lg); color: var(--color-text-muted); font-weight: 800; }
  .featured-case__actions { display: grid; gap: var(--space-sm); justify-items: start; }
  .featured-case__external { display: inline-flex; gap: var(--space-xs); align-items: center; min-height: 2.85rem; border: 1px solid rgba(255, 176, 0, 0.34); border-radius: var(--radius-md); padding: 0.78rem 1rem; background: rgba(255, 79, 0, 0.08); color: var(--color-brand-amber); font-weight: 900; line-height: 1; text-decoration: none; transition: border-color 160ms ease, background 160ms ease, color 160ms ease, transform 160ms ease; }
  .featured-case__external:hover, .featured-case__external:focus-visible { border-color: var(--color-brand); background: rgba(255, 79, 0, 0.16); color: var(--color-text); transform: translateY(-1px); }
  .case-label { margin: 0; color: var(--color-brand-amber); font-size: 0.76rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; }
  .featured-case__lead, .featured-case__capability p:last-child { margin: var(--space-lg) 0 0; max-width: 42rem; color: var(--color-text); font-size: clamp(1.25rem, 3vw, 2rem); font-weight: 800; line-height: 1.2; }
  .delivery-list { display: grid; gap: var(--space-sm); margin: var(--space-lg) 0 0; padding: 0; list-style: none; }
  .delivery-list li { position: relative; border-top: 1px solid var(--color-border); padding: var(--space-sm) 0 var(--space-sm) 1.2rem; color: var(--color-text-muted); }
  .delivery-list li::before { position: absolute; left: 0; top: 1.25rem; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--color-brand); content: ""; }
  .evidence-layout { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2.5rem, 7vw, 5rem); align-items: start; }
  .evidence-list { margin: 0; padding: 0; list-style: none; }
  .evidence-list li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--space-md); align-items: baseline; border-top: 1px solid var(--color-border); padding-block: var(--space-lg); color: var(--color-text); font-size: clamp(1.05rem, 2vw, 1.3rem); font-weight: 800; }
  .evidence-list li:last-child { border-bottom: 1px solid var(--color-border); }
  .evidence-list span { color: var(--color-brand); font-size: 0.78rem; }
  .future-case-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-md); margin-top: var(--space-2xl); }
  .future-case { min-height: 20rem; padding: clamp(1.5rem, 4vw, 2.5rem); }
  .future-case::before { display: block; width: 2.4rem; height: 0.18rem; margin-bottom: var(--space-lg); border-radius: 999px; background: var(--color-brand); box-shadow: 0 0 18px rgba(255, 79, 0, 0.36); content: ""; }
  .future-case__status { color: var(--color-brand-amber); font-size: 0.76rem; font-weight: 900; letter-spacing: 0.1em; }
  .future-case h3 { margin: var(--space-lg) 0 0; max-width: 18ch; font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1; }
  .future-case p { margin: var(--space-lg) 0 0; max-width: 35rem; color: var(--color-text-muted); }

  @media (max-width: 900px) {
    .cases-hero__inner, .evidence-layout { grid-template-columns: 1fr; }
  }

  @media (max-width: 720px) {
    .featured-case__content, .future-case-grid { grid-template-columns: 1fr; }
    .featured-case__content > section:nth-child(2) { border-top: 1px solid var(--color-border); border-left: 0; }
    .featured-case__capability, .featured-case__testimonial { grid-column: auto; }
    .featured-case__testimonial { grid-template-columns: 1fr; }
    .future-case { min-height: auto; }
  }

  @media (max-width: 560px) {
    .cases-hero { padding-block-start: 3.5rem; }
    .cases-hero h1 { font-size: clamp(2.8rem, 15vw, 4.5rem); }
    .cases-hero__signal { min-height: 19rem; }
  }
</style>
