---
import { footerNavigation, site } from '../data/site';
import poweredByLogo from '../images/poweredby-maxai.PNG';
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__brand">
      <a class="brand brand--powered" href="/" aria-label="Powered by MaximisedAI">
        <img
          class="brand__logo"
          src={poweredByLogo.src}
          alt="Powered by MaximisedAI"
          width={poweredByLogo.width}
          height={poweredByLogo.height}
        />
      </a>
      <p>
        MGRNZ advises. MaximisedAI builds.
      </p>
      <dl class="distinction">
        <div>
          <dt>MGRNZ</dt>
          <dd>Assess &bull; Advise &bull; Strategise &bull; Educate</dd>
        </div>
        <div>
          <dt>MaximisedAI</dt>
          <dd>Build &bull; Integrate &bull; Automate &bull; Operate</dd>
        </div>
      </dl>
      <p class="site-footer__fineprint">
        Practical AI systems, automations and digital infrastructure for New Zealand
        businesses.
      </p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      {footerNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background:
      radial-gradient(circle at -6% 0%, rgba(255, 79, 0, 0.16), transparent 26rem),
      radial-gradient(circle at 110% 0%, rgba(169, 0, 27, 0.14), transparent 28rem),
      var(--color-footer);
    color: var(--color-text-muted);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 28rem);
    gap: var(--space-2xl);
    padding-block: var(--space-3xl);
  }

  .site-footer__brand p {
    max-width: 38rem;
    margin: var(--space-md) 0 0;
    color: var(--color-text);
    font-weight: 800;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    color: var(--color-text);
    font-weight: 900;
    text-decoration: none;
  }

  .brand__logo {
    width: clamp(13rem, 24vw, 18rem);
    height: auto;
    filter: drop-shadow(0 0 18px rgba(255, 79, 0, 0.2));
  }

  .distinction {
    display: grid;
    gap: var(--space-sm);
    margin: var(--space-lg) 0 0;
  }

  .distinction div {
    border-left: 2px solid rgba(255, 79, 0, 0.5);
    padding-left: var(--space-md);
  }

  .distinction dt {
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .distinction dd {
    margin: 0.2rem 0 0;
  }

  .site-footer__fineprint {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm) var(--space-lg);
  }

  .footer-nav a {
    color: var(--color-text-muted);
    font-weight: 700;
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--color-brand-amber);
  }

  @media (max-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
